# 新服务接入统一登录：复制到新服务的 .env
# 本服务不保存登录密码，密码只在 auth-server 配置。

AUTH_ENABLED=true

# 必须与 auth-server 完全一致；修改会让所有已登录会话失效
# 生成示例：openssl rand -hex 32
APP_SECRET=

# auth-server 的登录页地址
SSO_LOGIN_URL=https://auth.o1-1.xct258.top/login

# 跨子域共享登录态
SSO_COOKIE_NAME=sso_session
SSO_COOKIE_DOMAIN=.o1-1.xct258.top

# 如果不是通过 NPM/nginx 访问，而是本机直接访问端口，
# 可以把 SSO_COOKIE_DOMAIN 留空；同一主机的不同端口共享 Cookie。
