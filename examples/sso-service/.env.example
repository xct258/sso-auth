# 新服务接入统一登录：在 auth-server 管理界面创建服务后复制这些值
# 本服务不保存登录密码，也不保存 SERVICE_SECRET。

AUTH_ENABLED=true

# 管理界面里的服务 ID
SERVICE_ID=

# auth-server 集中验签地址
SSO_VERIFY_URL=https://auth.xct258.top/api/auth/verify

# auth-server 的登录页地址
SSO_LOGIN_URL=https://auth.xct258.top/login

# 管理界面生成的 Cookie 名，例如 sso_taskops
SSO_COOKIE_NAME=

# 跨子域共享 Cookie
SSO_COOKIE_DOMAIN=.xct258.top
