# 新服务接入统一登录：在 auth-server 管理界面创建服务后复制这些值
# 本服务不保存登录密码，密码哈希只在 auth-server。

AUTH_ENABLED=true

# 管理界面里的服务 ID
SERVICE_ID=

# 该服务自己的签名密钥（管理界面生成）
SERVICE_SECRET=

# 该服务的 Token 版本（管理界面生成）
SERVICE_TOKEN_VERSION=1

# auth-server 的服务状态地址；用于“强制下线”下次访问生效
SSO_STATE_URL=http://127.0.0.1:8290/api/auth/service

# auth-server 的登录页地址
SSO_LOGIN_URL=https://auth.xct258.top/login

# 管理界面生成的 Cookie 名，例如 sso_taskops
SSO_COOKIE_NAME=

# 跨子域共享 Cookie
SSO_COOKIE_DOMAIN=.xct258.top
