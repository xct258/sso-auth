# 统一登录中心运行配置（复制为 .env 后修改）

# 访问密码；留空 = 不启用登录
APP_PASSWORD=change-me

# 会话签名密钥：必须是随机长字符串，且与 push-server / TaskOps 完全一致
# 生成示例：openssl rand -hex 32
APP_SECRET=

# 会话有效天数
SSO_SESSION_DAYS=7

# Cookie 名与父域（跨子域 SSO 必填，注意前面的点）
SSO_COOKIE_NAME=sso_session
SSO_COOKIE_DOMAIN=.o1-1.xct258.top

# 本服务对外登录地址
SSO_LOGIN_URL=https://auth.o1-1.xct258.top/login

# 只允许跳回这些子域，防止开放重定向
SSO_ALLOWED_REDIRECT_SUFFIX=.o1-1.xct258.top

# 登录中心自己的主机名（不要带协议和端口）
SSO_PUBLIC_HOST=auth.o1-1.xct258.top

# 没有 next 参数时，登录成功后默认去哪里（可留空）
SSO_DEFAULT_REDIRECT=

# 登录页显示
SSO_SITE_NAME=统一登录
SSO_WALLPAPER_URL=https://random-image.xct258.top/

# 监听端口
UVICORN_PORT=8290
