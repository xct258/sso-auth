# auth-server 运行配置（复制为 .env 后修改；不要提交真实密钥）

# --- 初始域名（第一次启动写入数据库，之后在 /admin 管理）---
AUTH_DOMAIN_NAME=xct258
AUTH_HOST=auth.xct258.top
AUTH_COOKIE_DOMAIN=.xct258.top
AUTH_ALLOWED_SUFFIX=.xct258.top
AUTH_SITE_NAME=统一登录
AUTH_WALLPAPER_URL=https://random-image.xct258.top/

# --- 初始管理员（仅首次启动创建）---
# ADMIN_PASSWORD 留空时自动生成，并写入 /data/initial_admin_password.txt
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_HOURS=12

# --- 服务会话默认值 ---
SSO_SESSION_DAYS=7

# --- 数据 ---
AUTH_DATA_DIR=/data
AUTH_DB_PATH=/data/auth.db
AUTH_KEY_PATH=/data/.master_key
# 可选：64 位 hex 主密钥；优先级高于文件
# AUTH_MASTER_KEY=

# --- 端口 ---
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8290
